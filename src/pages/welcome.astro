---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const welcome = await getEntry("pages", "welcome");

if (!welcome) {
  throw new Error(
    "Missing content entry: `welcome.md` or `welcome.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(welcome);
---

<Layout
  title={`${welcome.data.title} | ${config.site.title}`}
  description={welcome.data.description}
  ogImage={welcome.data.ogImage}
  canonicalURL={welcome.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={welcome.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
